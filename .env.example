# Variables to set in Railway -> your web service -> Variables.   (Never commit a real .env)
# Railway: add a PostgreSQL service, then reference it:   DATABASE_URL = ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/railway

# Optional
APP_DEBUG=false                 # true only while troubleshooting (shows error text in API responses)
ALLOW_SELF_SIGNUP=false         # true = anyone can create a least-privilege Staff account
# SOCIAL_REDIRECT_URI=https://YOUR-APP.up.railway.app/api/social.php
# SOCIAL_GOOGLE_ID=  SOCIAL_GOOGLE_SECRET=  SOCIAL_FACEBOOK_ID=  SOCIAL_FACEBOOK_SECRET=
# SOCIAL_GITHUB_ID=  SOCIAL_GITHUB_SECRET=  SOCIAL_LINKEDIN_ID=  SOCIAL_LINKEDIN_SECRET=
